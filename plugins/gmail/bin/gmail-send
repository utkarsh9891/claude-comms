#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""Send mail with local attachments from any terminal, through the Gmail API.

  gmail-send <to>[,<to>…] -s "<subject>" [--cc <addr>[,…]] [--file <path>]… [--html <file>] [--draft] [--no-signature] [text… | -]
  gmail-send --reply-to <message id> [--all] [--no-quote] [--to …] [--cc …] [-s …] [--file …] [--html …] [--draft] [text… | -]
  gmail-send --arm <to>[,…] [--cc …] -s "<subject pattern>" [--for 45m] [--times N] "<text pattern>"
  gmail-send --armed                       list armed patterns
  gmail-send --disarm [<id>]               drop one armed pattern, or all (no Touch ID)
  gmail-send setup <client_secret….json>   store your Desktop-app OAuth client (once per machine)
  gmail-send login                         sign in to Google (send, drafts; read an email only to reply to it)
  gmail-send status                        client, account, Touch ID helper, send folders
  gmail-send logout                        delete the sign-in from this Mac (no Touch ID)
  gmail-send signature [--refresh]         show the saved signature, or fetch Gmail's again (one scan)

--reply-to answers a Gmail message in its thread (id from the Gmail URL or the connector): to its sender, or with
--all to everyone on it except you; subject "Re: <original>" unless -s; --to/--cc replace the recipients. The
original is quoted below your text, as Gmail does, unless --no-quote. It reads that one email and sends in the same
single Touch ID scan; the quoted text is never printed. --dry-run shows the recipients found first.

<to> and --cc take plain addresses, comma-separated; "me" is the signed-in address. Text is the remaining
arguments, or stdin with "-". --html adds an HTML version from a file in the send folders, or from stdin
with `--html -` (then the text comes from the arguments); the text stays as the plain version. --draft saves it to Gmail
Drafts instead of sending (check and send it from Gmail). --dry-run prints what would be sent and stops.
Your signature (~/.gmail-send/signature.html, saved from Gmail at login; edit freely) is added under your text,
above any quote, unless --no-signature.

--arm approves, with one Touch ID scan now, up to N emails (--times, default 1, at most 20) to exactly those
recipients whose subject and text fit the patterns, sent later without asking, within --for (default and at most
1 hour: Google's key lifetime). Patterns are fixed text with slots: {num} a number, {id} a short ID (ticket, PR,
branch, SHA), {url} one https link, {text} any line up to 100 characters; {{ and }} are literal braces. Files,
HTML, drafts and replies never use an armed pattern.

Otherwise every send, draft and reply, to anyone including yourself, waits for one Touch ID scan ("Gmail for Claude"):
the Google sign-in is stored only locked to it. The prompt names every recipient, the subject, each attachment
and the start of the text; for a reply, the email and "its sender" or "everyone on it" (names you give with
--to/--cc are listed). Attachments come only from ~/Downloads, ~/Desktop, ~/Documents and ~/Pictures (no hidden
files), 25 MB in total. ADRs 2026-11-05-d38d84, 2026-11-05-847f76.
"""
import argparse
import sys

import gmailsend as g


def arm_args(argv):
    p = argparse.ArgumentParser(prog="gmail-send --arm", add_help=False)
    p.add_argument("to")
    p.add_argument("--cc", action="append", default=[])
    p.add_argument("-s", "--subject", required=True)
    p.add_argument("--for", dest="for_value")
    p.add_argument("--times", type=int, default=1)
    p.add_argument("text", nargs="*")
    return p.parse_intermixed_args(argv)


def send_args(argv):
    replying = any(a == "--reply-to" or a.startswith("--reply-to=") for a in argv)
    p = argparse.ArgumentParser(prog="gmail-send", add_help=False)
    if replying:  # recipients come from the original unless --to/--cc say otherwise; every positional is text
        p.add_argument("--to", action="append", default=[])
        p.add_argument("--reply-to", required=True)
        p.add_argument("--all", action="store_true")
        p.add_argument("--no-quote", action="store_true")
        p.add_argument("-s", "--subject")
    else:
        p.add_argument("to")
        p.add_argument("--all", action="store_true")
        p.add_argument("-s", "--subject", required=True)
    p.add_argument("--cc", action="append", default=[])
    p.add_argument("--file", action="append", default=[])
    p.add_argument("--html")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-signature", action="store_true")
    p.add_argument("--draft", action="store_true")
    p.add_argument("text", nargs="*")
    return p.parse_intermixed_args(argv)  # text may follow the options


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd = argv[0]
    try:
        if cmd == "setup":
            if len(argv) != 2:
                raise g.Refused("usage: gmail-send setup <client_secret….json>")
            cid = g.setup(argv[1])
            print(f"Stored OAuth client …{cid[-40:]} in {g.HOME}/client.json. Next: gmail-send login")
        elif cmd == "login":
            print(f"Signed in as {g.login()}. The sign-in is locked to your Touch ID.")
        elif cmd == "status":
            print(g.status())
        elif cmd == "logout":
            who = g.logout()
            print(f"Signed out {who}: the sealed sign-in and its key are deleted from this Mac. To also remove "
                  f"the app's access at Google: {g.REVOKE_PAGE}" if who else "Not signed in.")
        elif cmd == "--arm":
            a = arm_args(argv[1:])
            g.arm([a.to], a.cc, a.subject, " ".join(a.text), for_value=a.for_value, times=a.times)
        elif cmd == "--armed":
            arms = g.armed_list()
            for e in arms:
                until = g.datetime.fromtimestamp(e["until"]).strftime("%H:%M")
                cc = f" cc {', '.join(e['cc'])}" if e["cc"] else ""
                print(f"{e['id']}  to {', '.join(e['to'])}{cc}  subject \"{e['subject']}\"  text \"{e['text']}\"  "
                      f"{e['left']} left, until {until}")
            if not arms:
                print("Nothing armed.")
        elif cmd == "--disarm":
            n = g.disarm(argv[1] if len(argv) > 1 else None)
            print(f"Dropped {n} armed pattern{'s' if n != 1 else ''}.")
        elif cmd == "signature":
            if argv[1:] == ["--refresh"]:
                sig = g.refresh_signature()
                print(f"Saved {'your Gmail signature' if sig else 'an empty signature (none set in Gmail)'} "
                      f"to {g.signature_path()}.")
            elif len(argv) == 1:
                sig = g.load_signature()
                print(f"{g.signature_path()}:\n{sig}" if sig else f"No signature ({g.signature_path()} missing or empty).")
            else:
                raise g.Refused("usage: gmail-send signature [--refresh]")
        else:
            a = send_args(argv)
            if a.html == "-" and a.text == ["-"]:
                raise g.Refused("stdin can carry the HTML or the text, not both: give the text as arguments")
            html_text = sys.stdin.read() if a.html == "-" else None
            text = sys.stdin.read() if a.text == ["-"] else " ".join(a.text)
            to = a.to if isinstance(a.to, list) else [a.to]
            g.send(to, a.cc, a.subject, text, a.file, html_file=None if a.html == "-" else a.html,
                   html_text=html_text, dry_run=a.dry_run, draft=a.draft,
                   reply_to=getattr(a, "reply_to", None), reply_all=a.all,
                   quote=not getattr(a, "no_quote", False), signature=not a.no_signature)
    except g.Refused as e:
        print(f"gmail-send: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("gmail-send: cancelled; nothing was sent", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
